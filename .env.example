# Skopiuj do .env (plik .env jest w .gitignore) i uzupełnij.
#   cp .env.example .env && chmod 600 .env

# Token Hugging Face (read). Potrzebny dla modeli z bramką licencyjną
# i żeby uniknąć limitów pobierania. https://huggingface.co/settings/tokens
HF_TOKEN=

# Obraz vLLM z NGC przygotowany pod ARM64 + CUDA 13 (DGX Spark).
# Lista tagów: https://catalog.ngc.nvidia.com/orgs/nvidia/containers/vllm
VLLM_IMAGE=nvcr.io/nvidia/vllm:26.09-py3

# Open WebUI (opcjonalny profil "ui"). Przypnij konkretną wersję zamiast :main,
# kiedy ustalisz działającą (https://github.com/open-webui/open-webui/releases).
OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui:main

# Katalogi danych na hoście
HF_HOME_HOST=/data/hf
DATA_VOLUMES=/data/volumes

TZ=Europe/Warsaw
