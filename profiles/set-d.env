# Zestaw D: asystent kodu (NIEPRZETESTOWANY)
#   Qwen3-Coder-Next (FP8, ~80 GB) na :8000 — endpoint dla OpenCode
#   bge-m3 na :8001
# FP8 zostawia niewiele miejsca na KV cache; jeśli kontekst 128k się nie mieści,
# zmniejsz LLM_MAX_LEN albo użyj wariantu 4-bit (NVFP4/AWQ) w models.yaml.

COMPOSE_PROFILES=embed

LLM_MODEL=qwen3-coder-next
LLM_GPU_MEM=0.82
LLM_MAX_LEN=131072
LLM_EXTRA_ARGS=--enable-auto-tool-choice --tool-call-parser qwen3_coder

EMBED_MODEL=bge-m3
EMBED_GPU_MEM=0.04
EMBED_EXTRA_ARGS=--runner pooling --max-model-len 8192
