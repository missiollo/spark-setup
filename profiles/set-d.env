# Zestaw D: asystent kodu (NIEPRZETESTOWANY)
#   Qwen3-Coder-Next (FP8, ~80 GB) na :8000 — endpoint dla OpenCode
#   bge-m3 na :8001
# FP8 zostawia niewiele miejsca na KV cache; jeśli kontekst 128k się nie mieści,
# zmniejsz LLM_MAX_LEN albo użyj wariantu 4-bit (NVFP4/AWQ) w models.yaml.

# --max-num-seqs: maks. liczba równoczesnych zapytań. Domyślne 256 nie mieści się przy
# modelach z warstwami Mamba/DeltaNet (Qwen3.6/3.8/Coder-Next): każde zapytanie zajmuje
# osobny blok cache. 16 wystarcza dla jednej osoby / małego zespołu.

COMPOSE_PROFILES=embed-8001

LLM_MODEL=qwen3-coder-next
LLM_GPU_MEM=0.82
LLM_MAX_LEN=131072
LLM_EXTRA_ARGS=--enable-auto-tool-choice --tool-call-parser qwen3_coder --max-num-seqs 16

EMBED_MODEL=bge-m3
EMBED_GPU_MEM=0.04
EMBED_EXTRA_ARGS=--runner pooling --max-model-len 8192
