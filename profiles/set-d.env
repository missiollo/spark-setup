# Zestaw D: kod — Qwen3-Coder-Next dla OpenCode + szybki Qwen3.6 + embeddingi
#   :8003  Qwen3-Coder-Next NVFP4  agent programistyczny (OpenCode na Macu przez tunel)
#   :8000  Qwen3.6-35B-A3B NVFP4   drobne zadania, czat (small_model w OpenCode)
#   :8001  bge-m3                  embeddingi
# Coder-Next zostaje na porcie 8003 jak w opisie OpenCode — konfiguracja klienta się nie zmienia.
# Przełączanie z zestawem B: make down && make up SET=d (ok. 5 min ładowania).
#
# Przydziały (*_GPU_MEM = ułamek ~119 GiB):
#   Qwen3.6 NVFP4 0.22 — zmierzone: wagi 19,6 GiB, 4,2 GiB na cache
#   Coder-Next NVFP4 0.47 — wagi ~43 GiB (wg autora wariantu GB10) + ~6 GiB bufory + cache;
#     NIEZMIERZONE — przy błędzie "No available memory for the cache blocks" zwiększyć
#   bge-m3 0.03
# Suma 0.72.
# Wersja FP8 Coder-Next (80 GB, qwen3-coder-next w models.yaml) nie mieści się obok innych modeli.

COMPOSE_PROFILES=embed-8001,vllm-8003

# --- :8000 Qwen3.6-35B-A3B
LLM_MODEL=qwen3.6-35b-a3b-nvfp4
LLM_GPU_MEM=0.22
LLM_MAX_LEN=32768
LLM_EXTRA_ARGS=--kv-cache-dtype fp8 --reasoning-parser qwen3 --enable-auto-tool-choice --tool-call-parser qwen3_coder --language-model-only --enable-chunked-prefill --max-num-seqs 16

# --- :8003 Qwen3-Coder-Next
LLM3_MODEL=qwen3-coder-next-nvfp4
LLM3_GPU_MEM=0.47
LLM3_MAX_LEN=65536
LLM3_EXTRA_ARGS=--kv-cache-dtype fp8 --enable-auto-tool-choice --tool-call-parser qwen3_coder --enable-chunked-prefill --max-num-seqs 16

# --- :8001 bge-m3
EMBED_MODEL=bge-m3
EMBED_GPU_MEM=0.03
EMBED_EXTRA_ARGS=--runner pooling --max-model-len 8192
