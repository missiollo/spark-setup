# Zestaw B: uniwersalny — wszystko z Qwena w NVFP4 (NIEPRZETESTOWANY)
#   :8000  Qwen3.6-35B-A3B   (~22 GB) szybki czat, agent, routing
#   :8002  Qwen3.8-27B       (~21 GB) jakość: text-to-SQL, ocena wymagań (PL)
#   :8003  Qwen3-Coder-Next  (~46 GB) kod / OpenCode
#   :8001  bge-m3            (~2 GB)  embeddingi
# Do pobrania ~90 GB — najpierw Spark na kablu.
#
# Pamięć (~119 GiB łącznie): suma *_GPU_MEM = 0.88. Zapas na KV cache jest mały
# (kilka GiB na model), dlatego KV cache w FP8 i umiarkowane konteksty.
# Modele Qwen3.6 / 3.8 / Coder-Next mają uwagę hybrydową (DeltaNet), więc
# KV cache rośnie wolniej niż w klasycznych modelach.
# Przy OOM: `make drop-caches`, potem obniż *_MAX_LEN albo zrezygnuj z llm3.

# --max-num-seqs: maks. liczba równoczesnych zapytań. Domyślne 256 nie mieści się przy
# modelach z warstwami Mamba/DeltaNet (Qwen3.6/3.8/Coder-Next): każde zapytanie zajmuje
# osobny blok cache. 16 wystarcza dla jednej osoby / małego zespołu.

COMPOSE_PROFILES=embed-8001,vllm-8002,vllm-8003

# --- :8000 Qwen3.6-35B-A3B
LLM_MODEL=qwen3.6-35b-a3b-nvfp4
LLM_GPU_MEM=0.22
LLM_MAX_LEN=32768
# Karta NVIDIA dla Sparka podaje --tool-call-parser qwen3_xml; karta Qwen — qwen3_coder.
# Jeśli tool calling zawodzi, przełącz na qwen3_xml.
LLM_EXTRA_ARGS=--kv-cache-dtype fp8 --reasoning-parser qwen3 --enable-auto-tool-choice --tool-call-parser qwen3_coder --language-model-only --enable-chunked-prefill --max-num-seqs 16

# --- :8002 Qwen3.8-27B
LLM2_MODEL=qwen3.8-27b-nvfp4
LLM2_GPU_MEM=0.20
LLM2_MAX_LEN=32768
LLM2_EXTRA_ARGS=--kv-cache-dtype fp8 --reasoning-parser qwen3 --enable-auto-tool-choice --tool-call-parser qwen3_coder --language-model-only --enable-chunked-prefill --max-num-seqs 16

# --- :8003 Qwen3-Coder-Next
LLM3_MODEL=qwen3-coder-next-nvfp4
LLM3_GPU_MEM=0.43
LLM3_MAX_LEN=65536
LLM3_EXTRA_ARGS=--kv-cache-dtype fp8 --enable-auto-tool-choice --tool-call-parser qwen3_coder --enable-chunked-prefill --max-num-seqs 16

# --- :8001 bge-m3
EMBED_MODEL=bge-m3
EMBED_GPU_MEM=0.03
EMBED_EXTRA_ARGS=--runner pooling --max-model-len 8192
