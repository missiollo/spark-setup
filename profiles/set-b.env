# Zestaw B: SOFA — dwa modele Qwen + Gemma 4 (NVFP4) + embeddingi
#   :8000  Qwen3.6-35B-A3B  szybki czat, agent, routing, tool calling
#   :8002  Qwen3.8-27B      jakość: text-to-SQL, ocena jakości wymagań (PL)
#   :8004  Gemma 4 26B-A4B  model ogólny spoza rodziny Qwen: tematy, których Qwen unika
#                           (np. polityka Chin), drugi punkt widzenia przy ocenie
#   :8001  bge-m3           embeddingi (RAG)
# Kod (Qwen3-Coder-Next) w zestawie D — trzy duże modele naraz się nie mieszczą.
#
# Przydziały wg pomiarów z 2026-10-11 (*_GPU_MEM = ułamek ~119 GiB pamięci zunifikowanej):
#   Qwen3.6 NVFP4: wagi 19,6 GiB; przy 0.22 zostało 4,2 GiB na cache -> 0.25 dla zapasu
#   Qwen3.8 NVFP4: wagi 19,1 GiB; przy 0.20 zabrakło 3 GiB na cache -> 0.30 (~9 GiB cache)
#   bge-m3: wagi 1,1 GiB, grafy 0,6 GiB
#   Gemma 4 26B-A4B NVFP4: wagi ~17 GiB (szacunek, NVFP4 tylko w ekspertach) -> 0.24; NIEZMIERZONE
# Suma 0.82 — blisko limitu ~0.85. Przy testach z analitykami (więcej pamięci na kontekst)
# Gemmę wyłączyć: usunąć vllm-8004 z COMPOSE_PROFILES.
#
# --max-num-seqs: maks. liczba równoczesnych zapytań. Domyślne 256 nie mieści się przy
# modelach z warstwami Mamba/DeltaNet (Qwen3.6/3.8/Coder-Next): każde zapytanie zajmuje
# osobny blok cache. 16 wystarcza dla jednej osoby / małego zespołu.

COMPOSE_PROFILES=embed-8001,vllm-8002,vllm-8004

# --- :8000 Qwen3.6-35B-A3B
LLM_MODEL=qwen3.6-35b-a3b-nvfp4
LLM_GPU_MEM=0.25
LLM_MAX_LEN=32768
# Karta NVIDIA dla Sparka podaje --tool-call-parser qwen3_xml; karta Qwen — qwen3_coder.
# Jeśli tool calling zawodzi, przełącz na qwen3_xml.
LLM_EXTRA_ARGS=--kv-cache-dtype fp8 --reasoning-parser qwen3 --enable-auto-tool-choice --tool-call-parser qwen3_coder --language-model-only --enable-chunked-prefill --max-num-seqs 16

# --- :8002 Qwen3.8-27B
LLM2_MODEL=qwen3.8-27b-nvfp4
LLM2_GPU_MEM=0.30
LLM2_MAX_LEN=32768
LLM2_EXTRA_ARGS=--kv-cache-dtype fp8 --reasoning-parser qwen3 --enable-auto-tool-choice --tool-call-parser qwen3_coder --language-model-only --enable-chunked-prefill --max-num-seqs 16

# --- :8001 bge-m3
EMBED_MODEL=bge-m3
EMBED_GPU_MEM=0.03
EMBED_EXTRA_ARGS=--runner pooling --max-model-len 8192

# --- :8004 Gemma 4 26B-A4B
# Parsery wg karty modelu (vllm serve ... --tool-call-parser gemma4 --reasoning-parser gemma4).
# Gemma nie ma warstw Mamba; max-num-seqs 16 ogranicza rezerwę na grafy CUDA.
LLM4_MODEL=gemma-4-26b-a4b-nvfp4
LLM4_GPU_MEM=0.24
LLM4_MAX_LEN=32768
LLM4_EXTRA_ARGS=--kv-cache-dtype fp8 --reasoning-parser gemma4 --enable-auto-tool-choice --tool-call-parser gemma4 --language-model-only --enable-chunked-prefill --max-num-seqs 16 --trust-remote-code

