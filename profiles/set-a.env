# Zestaw A: porównanie modeli dla SOFA (NIEPRZETESTOWANY — dostroić po zestawie C)
#   gpt-oss-120b (MXFP4, ~65 GB) na :8000
#   Qwen3.8-27B (FP8, ~29 GB) na :8002
#   bge-m3 na :8001
# Wymaga Sparka na kablu (~96 GB do pobrania). Pamięć na styk — mały zapas na KV cache.
# Jeśli brakuje pamięci: Qwen3.8-27B w NVFP4/AWQ albo krótszy LLM_MAX_LEN.

# --max-num-seqs: maks. liczba równoczesnych zapytań. Domyślne 256 nie mieści się przy
# modelach z warstwami Mamba/DeltaNet (Qwen3.6/3.8/Coder-Next): każde zapytanie zajmuje
# osobny blok cache. 16 wystarcza dla jednej osoby / małego zespołu.

COMPOSE_PROFILES=embed-8001,vllm-8002

LLM_MODEL=gpt-oss-120b
LLM_GPU_MEM=0.58
LLM_MAX_LEN=32768
# Sprawdź parsery w aktualnej dokumentacji vLLM dla gpt-oss.
LLM_EXTRA_ARGS=--enable-auto-tool-choice --tool-call-parser openai --reasoning-parser openai_gptoss --max-num-seqs 32

LLM2_MODEL=qwen3.8-27b
LLM2_GPU_MEM=0.27
LLM2_MAX_LEN=32768
LLM2_EXTRA_ARGS=--reasoning-parser qwen3 --enable-auto-tool-choice --tool-call-parser qwen3_coder --language-model-only --max-num-seqs 16

EMBED_MODEL=bge-m3
EMBED_GPU_MEM=0.04
EMBED_EXTRA_ARGS=--runner pooling --max-model-len 8192
