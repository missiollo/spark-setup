# Zestaw A: gpt-oss-120b + embeddingi — do porównania z zestawem B
#   :8000  gpt-oss-120b (MXFP4, ~61 GiB wag)
#   :8001  bge-m3
# Porównanie z Qwen3.8 (zestaw B) przez przełączenie zestawu i ten sam test (bench/),
# a nie przez jednoczesne uruchomienie — gpt-oss + Qwen3.8 FP8 + bufory to ~100% pamięci.
#
# Przydział 0.66 (~79 GiB): wagi ~61 GiB + bufory + cache. NIEZMIERZONE — sprawdzić
# "Available KV cache memory" w `make errors` po pierwszym starcie.
#
# --max-num-seqs 32: gpt-oss nie ma warstw Mamba, ale domyślne 256 niepotrzebnie
# zwiększa rezerwę na grafy CUDA.

COMPOSE_PROFILES=embed-8001

LLM_MODEL=gpt-oss-120b
LLM_GPU_MEM=0.66
LLM_MAX_LEN=65536
# Sprawdź parsery w aktualnej dokumentacji vLLM dla gpt-oss.
LLM_EXTRA_ARGS=--enable-auto-tool-choice --tool-call-parser openai --reasoning-parser openai_gptoss --max-num-seqs 32

EMBED_MODEL=bge-m3
EMBED_GPU_MEM=0.03
EMBED_EXTRA_ARGS=--runner pooling --max-model-len 8192
