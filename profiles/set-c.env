# Zestaw C: lekki start
#   Qwen3.6-35B-A3B (FP8, ~37 GB) na :8000 + bge-m3 (embeddingi) na :8001
# Cel: sprawdzić cały łańcuch (vLLM, tunel, OpenCode, benchmark) małym kosztem.
#
# Pamięć: --gpu-memory-utilization to ułamek CAŁEJ pamięci zunifikowanej (~119 GiB),
# który instancja rezerwuje z góry (wagi + KV cache). Suma instancji < ~0.85,
# żeby zostało miejsce dla systemu.

COMPOSE_PROFILES=embed

# --- Model główny (usługa "llm", port 8000)
LLM_MODEL=qwen3.6-35b-a3b
LLM_GPU_MEM=0.55
LLM_MAX_LEN=65536
# Parsery wg karty modelu Qwen3.6 (vllm serve ... --reasoning-parser qwen3
# --enable-auto-tool-choice --tool-call-parser qwen3_coder).
# --language-model-only: bez enkodera obrazu, więcej miejsca na KV cache.
LLM_EXTRA_ARGS=--reasoning-parser qwen3 --enable-auto-tool-choice --tool-call-parser qwen3_coder --language-model-only

# --- Embeddingi (usługa "embed", port 8001)
EMBED_MODEL=bge-m3
EMBED_GPU_MEM=0.06
# Starsze wersje vLLM: "--task embed" zamiast "--runner pooling".
EMBED_EXTRA_ARGS=--runner pooling --max-model-len 8192
