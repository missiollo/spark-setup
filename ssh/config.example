# Wpis do ~/.ssh/config na Macu (chmod 600 ~/.ssh/config).
#   ssh spark      -> terminal + tunele
#   ssh -N spark   -> same tunele
# Po resecie fabrycznym Sparka: ssh-keygen -R spark-28e3.local

Host spark
  HostName spark-28e3.local
  User michal
  IdentityFile ~/.ssh/id_ed25519
  ServerAliveInterval 30
  ExitOnForwardFailure yes
  LocalForward 8000 127.0.0.1:8000   # vLLM — model główny
  LocalForward 8001 127.0.0.1:8001   # vLLM — embeddingi
  LocalForward 8002 127.0.0.1:8002   # vLLM — drugi model (zestawy A, B)
  LocalForward 8003 127.0.0.1:8003   # vLLM — trzeci model (zestaw B: Coder-Next)
  LocalForward 8080 127.0.0.1:8080   # Open WebUI
