# Wpis do ~/.ssh/config na Macu (chmod 600 ~/.ssh/config).
#   ssh spark      -> terminal + tunele
#   ssh -N spark   -> same tunele, bez terminala
# Po resecie fabrycznym Sparka: ssh-keygen -R spark-28e3.local
# Komentarze tylko w osobnych liniach (OpenSSH nie gwarantuje komentarzy na końcu linii).

Host spark
  HostName spark-28e3.local
  User michal
  IdentityFile ~/.ssh/id_ed25519
  # Co 30 s sygnał "żyję", żeby połączenie nie zrywało się przy bezczynności
  ServerAliveInterval 30
  # Przerwij połączenie, jeśli któregoś portu nie da się otworzyć (np. zajęty na Macu)
  ExitOnForwardFailure yes

  # :8000 vLLM, model główny (zestaw B: Qwen3.6-35B-A3B, szybki czat i agent)
  LocalForward 8000 127.0.0.1:8000
  # :8001 vLLM, embeddingi (bge-m3, do RAG)
  LocalForward 8001 127.0.0.1:8001
  # :8002 vLLM, drugi model (zestawy A i B: Qwen3.8-27B, jakość, SQL, ocena wymagań)
  LocalForward 8002 127.0.0.1:8002
  # :8003 vLLM, trzeci model (zestaw D: Qwen3-Coder-Next, kod, OpenCode)
  LocalForward 8003 127.0.0.1:8003
  # :8080 Open WebUI, czat w przeglądarce (tylko po make up-ui)
  LocalForward 8080 127.0.0.1:8080